# ══════════════════════════════════════════════════════════════
#  درب الألمانية (DeutschPfad) — متغيرات البيئة
# ══════════════════════════════════════════════════════════════
#  ملاحظة مهمة: الموقع يعمل بالكامل (100%) بدون هذه المفاتيح.
#  مفاتيح LLM تخص فقط "الميزات الذكية" (المرحلة 5 و11) —
#  وبدونها تُخفى هذه الميزات تلقائياً من الواجهة.

# ── عنوان الموقع (يُستخدم في الـ Metadata و sitemap) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── مزودو الذكاء الاصطناعي (اختياري) ──────────────────────
# الأساسي: Google Gemini 2.5 Flash — مجاني ~1500 طلب/يوم
GEMINI_API_KEY=
# الاحتياطي الأول: Groq — مجاني وسريع
GROQ_API_KEY=
# الاحتياطي الثاني: OpenRouter — تشكيلة نماذج واسعة
OPENROUTER_API_KEY=

# ── سقف الطلبات اليومي لميزات الذكاء الاصطناعي (بالكود) ──
NEXT_PUBLIC_LLM_DAILY_LIMIT=50
